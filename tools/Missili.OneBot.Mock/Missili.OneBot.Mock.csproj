<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <PropertyGroup>
    <!-- CLI 和调试入口均以仓库根目录解析合成场景，不依赖调用者当前目录。 -->
    <!-- https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props#run-related-properties -->
    <RunWorkingDirectory>$(MissiliRepositoryRoot)</RunWorkingDirectory>
  </PropertyGroup>
</Project>
