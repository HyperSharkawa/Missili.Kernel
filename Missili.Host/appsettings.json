{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Infrastructure": {
    "DataDirectory": "data",
    "IngressCapacity": 512,
    "MessageConcurrency": 32,
    "PluginConcurrency": 32,
    "PerPluginConcurrency": 4,
    "InvocationCapacity": 512,
    "WriteCapacity": 256,
    "ReadConcurrency": 4,
    "DownloadConcurrency": 4,
    "DownloadCapacity": 128,
    "ConnectTimeout": "00:00:10",
    "HeadersTimeout": "00:00:30",
    "ReadIdleTimeout": "00:01:00",
    "PluginStopTimeout": "00:00:30"
  },
  "Plugins": []
}
